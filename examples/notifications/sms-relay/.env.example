# Copy to .env beside compose.yml. .env is ignored by Git.
SIGNALWIRE_SPACE=example.signalwire.com
SIGNALWIRE_FROM_NUMBER=+15550100001

# Safe default: only these E.164 recipients may be charged. Comma-separated.
SMS_ALLOWED_RECIPIENTS=+15550100002

# The Docker network created by Harbor's default Compose project.
HARBOR_NETWORK=harbor_default

# Cost/abuse guardrails. Provider-side spending caps are still recommended.
RELAY_RATE_LIMIT_PER_MINUTE=6
RELAY_DAILY_LIMIT=100
MAX_MESSAGE_CHARS=480
UPSTREAM_TIMEOUT_MS=10000
