# Copy to .env beside compose.yml. .env is ignored by Git.
NTFY_BASE_URL=https://ntfy.example.invalid
NTFY_PORT=8085
NTFY_TIMEZONE=UTC

# The Docker network created by Harbor's default Compose project.
HARBOR_NETWORK=harbor_default

# Run as the owner of ./data. On Linux, `id -u` and `id -g` show these values.
NTFY_UID=1000
NTFY_GID=1000
