# ── Harbor configuration ────────────────────────────────────────────
# Random string used to sign sessions and encrypt integration secrets.
# Generate with:  openssl rand -hex 32
HARBOR_SECRET=change-me

# Port inside the container (Traefik targets this)
PORT=9090

# Path to the SQLite database (the Docker volume mounts /data)
HARBOR_DATA=/data

# Signed-cookie lifetime. Security-sensitive account changes revoke all prior
# cookies immediately regardless of this expiry (allowed range: 1-90).
SESSION_DAYS=7

# One-time first-run bootstrap credential. Leave both blank to have Harbor
# generate /data/.setup-token. Read it with:
#   docker compose exec harbor cat /data/.setup-token
# For Docker secrets, set HARBOR_SETUP_TOKEN_FILE to the mounted secret path.
HARBOR_SETUP_TOKEN=
HARBOR_SETUP_TOKEN_FILE=

# Temporary rotation aid: set this to the old master secret's read-only path
# inside the container while HARBOR_SECRET points to the new one. Harbor
# transactionally re-encrypts stored credentials; remove the mount and this
# setting after one successful start and verified backup.
HARBOR_PREVIOUS_SECRET_FILE=

# Canonical browser-facing origin, with no trailing slash. Required for proxy
# auth and recommended for absolute calendar subscription/reset links.
PUBLIC_URL=

# ── SSO via Traefik forward-auth ────────────────────────────────────
# When true, Harbor trusts identity headers set by your auth proxy
# (oauth2-proxy, traefik-forward-auth, Authelia, ...) and logs you in
# automatically — same behavior as Organizr's Auth Proxy.
AUTH_PROXY=false

# Stable name for this identity provider. Changing it creates a separate SSO
# identity namespace, so keep it fixed after users first sign in.
AUTH_PROXY_PROVIDER=proxy

# Headers checked for the provider's stable subject, first match wins.
AUTH_PROXY_HEADERS=Remote-User,X-Forwarded-User,X-Forwarded-Email,X-Auth-Request-Email

# Required when AUTH_PROXY=true. Set only the exact IPv4 proxy/container subnet
# or address that may assert identity (/16 or narrower); there is no broad default.
AUTH_PROXY_TRUSTED=

# Comma-separated usernames/emails that get the admin role on first login.
ADMIN_USERS=admin@example.invalid

# ── Server-side outbound access policy ─────────────────────────────
# Public destinations and normal private Docker/LAN/CGNAT/ULA addresses are
# allowed by default. Loopback, link-local/metadata, multicast, and other
# unspecified/reserved addresses are always denied.
#
# Optional hardened mode: require every private destination to match the
# smallest required network(s) or exact service names below. This is normally
# unnecessary for a trusted self-hosted Docker stack.
HARBOR_OUTBOUND_STRICT_PRIVATE=false
HARBOR_OUTBOUND_ALLOW_CIDRS=
HARBOR_OUTBOUND_ALLOW_HOSTS=
HARBOR_OUTBOUND_MAX_CONCURRENCY=12
HARBOR_OUTBOUND_PER_ORIGIN=4

# Security audit history is bounded by both age and row count.
HARBOR_AUDIT_RETENTION_DAYS=180
HARBOR_AUDIT_MAX_ROWS=20000

# Optional PEM CA bundle for a private SMTP relay. Prefer this over disabling
# TLS certificate verification in Harbor's notification settings.
HARBOR_SMTP_CA_FILE=
